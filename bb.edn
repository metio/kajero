{:tasks
 {test {:doc "Run the test suite (kaocha)"
        :task (shell "clojure -M:test")}
  lint {:doc "clj-kondo over the code base"
        :task (shell "clj-kondo --lint src test")}
  web {:doc "The pages for humans on http://127.0.0.1:7270 (KAJERO_PORT)"
       :task (shell "clojure -M:web")}
  mcp {:doc "MCP server over stdio (KAJERO_DB, KAJERO_ACTOR, KAJERO_KEY)"
       :task (shell "clojure -M:mcp")}
  uber {:doc "The AOT uberjar of kajero.main (target/kajero.jar)"
        :task (shell "clojure -T:build uber")}
  build-native {:doc "The single-binary kajero (GraalVM native-image -> target/kajero)"
                :task (shell "sh dev/build-native.sh")}
  smoke {:doc "Smoke-test a built kajero (bb smoke, or bb smoke java -jar target/kajero.jar)"
         :task (apply shell "bb dev/smoke.clj" *command-line-args*)}
  kajero {:doc "Run the CLI (bb kajero search 'label:kind=gotcha')"
          :task (apply shell "clojure -M:run" *command-line-args*)}}}
