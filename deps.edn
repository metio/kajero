{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        ;; tik.sign signs and verifies revisions with the actors' tik keys
        io.github.metio/tik {:git/sha "8447157bce1a8d3a6f3222dbff796b887427633b"}
        ;; briko.ssh-sign and briko.sshsig sign and verify records,
        ;; checkpoints and skill manifests
        io.github.metio/briko {:git/sha "3e8fc5431a6d5f2e7b70ac62994065784bbc5b16"}
        ;; kajero.mcp and kajero.web read and write JSON with it; declared
        ;; at the version tik brings, so the resolution stays the same
        cheshire/cheshire {:mvn/version "6.2.0"}
        org.xerial/sqlite-jdbc {:mvn/version "3.54.1.0"}
        metosin/malli {:mvn/version "0.20.3"}
        hiccup/hiccup {:mvn/version "2.0.0-RC1"}
        org.commonmark/commonmark {:mvn/version "0.24.0"}
        org.commonmark/commonmark-ext-gfm-tables {:mvn/version "0.24.0"}}
 :aliases
 {;; graal-build-time initialises the Clojure namespaces at image build
  ;; time, which native-image needs for AOT-compiled Clojure
  :native {:extra-deps {com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}}
  ;; the AOT uberjar of kajero.main: clojure -T:build uber (build.clj);
  ;; src for kajero.skill-files, which stages the skills
  ;; into the jar
  :build {:extra-paths ["." "src"]
          :deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}
  :web {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "kajero.web"]}
  :mcp {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "kajero.mcp"]}
  :run {:jvm-opts ["--enable-native-access=ALL-UNNAMED"]
        :main-opts ["-m" "kajero.cli"]}
  :eastwood {:extra-paths ["test"]
             :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
             :extra-deps {jonase/eastwood {:mvn/version "1.4.3"}
                          lambdaisland/kaocha {:mvn/version "1.91.1392"}}
             :main-opts ["-m" "eastwood.lint" "{:source-paths [\"src\"] :test-paths [\"test\"]}"]}
  :splint {:extra-deps {io.github.noahtheduke/splint {:mvn/version "1.25.0"}}
           :main-opts ["-m" "noahtheduke.splint" "src" "test"]}
  :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.6"}}
           :main-opts ["-m" "cljfmt.main"]}
  :watson {:extra-deps {io.github.clj-holmes/clj-watson {:git/tag "v6.2.0" :git/sha "c0dcdf323efb349baa9ec964298f725baccda73b"}}
           :main-opts ["-m" "clj-watson.cli" "scan"]}}}
